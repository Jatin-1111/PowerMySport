# ── Client (main app) environment variables ───────────────────────────────────
#
# Copy to .env.local for local development. Every NEXT_PUBLIC_* value is inlined
# into the browser bundle at build time and is therefore PUBLIC — never put a
# secret behind a NEXT_PUBLIC_ prefix.
#
# The three sibling apps (server, admin, community) each have their own
# .env.example. This one is new; it was added while wiring up server-side route
# protection, which introduced the first non-public variables this app needs.


# ── Required ──────────────────────────────────────────────────────────────────

# Backend API base URL. MUST include the /api suffix.
# Local: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Identity Services client ID, for the "Continue with Google" buttons.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web-push VAPID public key, for browser notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# ── Route protection (proxy) ──────────────────────────────────────────────────

# JWT signing secret. NOT NEXT_PUBLIC — it must never reach the browser.
#
# Must be byte-identical to the API's JWT_SECRET, because src/proxy.ts (Next's
# proxy convention, formerly middleware) verifies the auth cookie the API signs. Without it, middleware cannot
# verify anything and degrades to letting the client-side guard decide: safe,
# but the server-side gate is inert.
#
# In production this is a second copy of a signing secret in a second
# deployment. That is a deliberate trade for edge-side enforcement, not an
# accident — see the RC-1 notes in the flow architecture audit.
JWT_SECRET=

# Set to "true" to have the proxy redirect requests with NO auth cookie to the
# login page before the page renders.
#
# LEAVE UNSET until at least 7 days after the auth-cookie maxAge change is live
# in production. The cookie only persists for sessions created after that change
# ships; anyone who signed in earlier still holds a 7-day token in localStorage
# with no cookie, and for them this setting is an infinite redirect loop
# (proxy -> /login -> login restores the user from localStorage -> back ->
# proxy), not a redirect. 7 days is the token's own lifetime.
PROXY_BLOCK_ANONYMOUS=


# ── Public URLs ───────────────────────────────────────────────────────────────

# Public origin for canonicals, Open Graph tags and sitemap URLs.
# NO trailing slash. Apex, not www: www redirects to the apex at the edge, so
# pointing canonicals at www would send Google to a URL that redirects away.
# Falls back to https://powermysport.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the community app.
#
# REQUIRED IN PRODUCTION when community is served from its own subdomain.
# Two things depend on it:
#   1. Links to community in the dashboard/coach nav (lib/community/url.ts),
#      which fall back to the relative path /community when unset.
#   2. The post-login return-path allowlist (lib/returnPath.ts). Community
#      bounces signed-out users here with ?next=<absolute community URL>, and
#      that URL is only honoured if its origin is allowlisted. If this is unset
#      and community lives on a subdomain, the return path is silently rejected
#      and users land on their default page instead of where they started.
# Leave empty for local same-origin/path-based setups.
NEXT_PUBLIC_COMMUNITY_APP_URL=

# Socket server origin, without the /api suffix. Derived from
# NEXT_PUBLIC_API_URL when unset.
NEXT_PUBLIC_SERVER_URL=


# ── Pricing ───────────────────────────────────────────────────────────────────
#
# NOTHING HERE. Fee and tax rates are server-side only (`SERVICE_FEE_RATE`,
# `TAX_RATE` and the SUBSCRIPTION_* variants in the API's env). The client asks
# the API for a price breakdown and renders what it is given.
#
# There used to be NEXT_PUBLIC_SERVICE_FEE_RATE / NEXT_PUBLIC_TAX_RATE copies
# here so the UI could compute totals itself. That meant the number a customer
# was shown and the number they were charged came from two independently
# configured sources, agreeing only by luck. Do not reintroduce them.



# ── Feature flags ─────────────────────────────────────────────────────────────
#
# Each defaults to LIVE. Set explicitly to "false" to serve the
# waitlist/coming-soon surface instead.

NEXT_PUBLIC_SHOP_IS_LIVE=true
NEXT_PUBLIC_BOOKING_IS_LIVE=true
NEXT_PUBLIC_EXPERTS_IS_LIVE=true
