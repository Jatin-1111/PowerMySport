{
  "name": "Powermysport",
  "private": true,
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "admin",
    "client",
    "community",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write"
    ],
    "server/**/*.{ts,js,mjs}": [
      "eslint --fix --no-warn-ignored --config server/eslint.config.mjs"
    ],
    "community/**/*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --no-warn-ignored --config community/eslint.config.mjs"
    ],
    "**/*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
