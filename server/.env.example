# Database
MONGODB_URI=mongodb://localhost:27017/powermysport

# JWT Secret
# Must be >= 32 chars; the server refuses to start without it.
# The main client app also needs this exact value if server-side route
# protection is enabled there — see client/.env.example.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Domain for the auth cookie, applied in production only.
#
# Set this to the parent domain WITH a leading dot (e.g. .powermysport.com) when
# the API is on its own subdomain. The auth cookie is what lets the frontends
# recognise a session server-side, and without a domain attribute the browser
# scopes it to the API host alone — so a client on powermysport.com never
# receives a cookie set by api.powermysport.com, and any server-side auth gating
# there can never see a session.
#
# Left unset in development so localhost works across ports.
AUTH_COOKIE_DOMAIN=

# Server Configuration
PORT=5000
NODE_ENV=development

# Redis (used for Socket.IO cross-instance adapter + presence tracking)
# Local:      redis://localhost:6379
# Production: redis://<your-elasticache-cluster>.cache.amazonaws.com:6379
REDIS_URL=redis://localhost:6379

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=teams@powermysport.com
EMAIL_PASSWORD=
EMAIL_FROM=teams@powermysport.com

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=powermysport-uploads

# Google OAuth (if applicable)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000

# VAPID Keys for Web Push Notifications
# Generate new keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:teams@powermysport.com

# PhonePe Payment Gateway (Sandbox/Production)
PHONEPE_CLIENT_ID=your-phonepe-client-id
PHONEPE_CLIENT_SECRET=your-phonepe-client-secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_REDIRECT_URL_BASE=http://localhost:3000
PHONEPE_CALLBACK_URL=http://localhost:5000/api/bookings/phonepe/callback
PHONEPE_CALLBACK_USERNAME=your-callback-username
PHONEPE_CALLBACK_PASSWORD=your-callback-password

# Gemini AI (for sport pathway generation)
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default model (tries gemini-2.5-flash → gemini-2.0-flash → gemini-1.5-flash)
GEMINI_MODEL_NAME=gemini-2.5-flash

# Pathway Scraper Configuration
# Number of days before a cached pathway is considered stale and eligible for refresh (default: 30)
PATHWAY_STALE_DAYS=30
# How often (in hours) the background scraper re-runs to refresh stale pathways (default: 24)
PATHWAY_REFRESH_INTERVAL_HOURS=24

# Feature Flags
# Set to true to include the /shop routes in the AI coach chat site-map and nav guidance.
# Keep false until the shop is publicly launched.
SHOP_IS_LIVE=false
# Set to true once the /booking marketplace (venues/coaches/academies) is back
# live — the AI chat will not recommend or link to it while this is false.
BOOKING_IS_LIVE=false

# ── Pricing (authoritative) ───────────────────────────────────────────────────
#
# These are the ONLY place fee/tax rates are configured. The client asks the API
# for a price breakdown (POST /bookings/quote, POST /coaches/subscriptions/quote)
# and renders what it is given, so there is one source for the number a customer
# is shown and the number they are charged. Do not add NEXT_PUBLIC_ copies of
# these to the client — see client/.env.example.
#
# Decimals. 0 means zero-commission (and therefore zero tax, since tax applies
# to the service fee, not the subtotal).
SERVICE_FEE_RATE=0
TAX_RATE=0.05

# Subscription equivalents. Each falls back to the booking rate above when unset.
SUBSCRIPTION_PLATFORM_FEE_RATE=
SUBSCRIPTION_TAX_RATE=
