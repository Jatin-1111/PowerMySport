x`# ── Never needed by EB ────────────────────────────────────────────────
node_modules/
dist/
coverage/
*.log
npm-debug.log*

# ── Secrets — set these as EB Environment Variables ──────────────────
.env
.env.*
*.env

# ── Local Docker / dev only — EB uses Dockerfile directly ─────────────
# Keeping docker-compose.yml out of the bundle prevents EB from switching
# to compose mode, which would require .env.docker (stripped above) and
# break the deployment. Use docker-compose locally as normal.
docker-compose.yml

# ── Prebuilt-image deploy: EB now pulls from ECR via Dockerrun.aws.json ─
# Source is no longer built on the instance, so it doesn't need to ship.
# Build + push the image locally (or in CI) before running `eb deploy`.
src/
package.json
package-lock.json
tsconfig.json
Dockerfile

# ── Dev / OS junk ─────────────────────────────────────────────────────
.DS_Store
debug_output.txt
docs/
src/**/*.test.ts
